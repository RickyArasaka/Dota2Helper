# DotaBlitz Configuration
# Copy this file to .env and edit as needed

# Server
BACKEND_PORT=8000
LOG_LEVEL=INFO

# API Keys (optional – increases rate limits)
OPENDOTA_API_KEY=
STRATZ_API_KEY=

# Cache
CACHE_TTL_HOURS=6

# Recommendation weights (must sum to 1.0)
WEIGHT_OPENDOTA=0.5
WEIGHT_DOTABUFF=0.3
WEIGHT_DOTAFIRE=0.2

# Minimum matches for a build to be considered
MIN_SAMPLE_SIZE=50
